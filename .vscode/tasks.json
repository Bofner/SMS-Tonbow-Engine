{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
            "label": "Launch Emulicious",
            "windows":{
				"command": "start \"\" javaw -jar ../../Emulicious-with-Java/Emulicious.jar output.sms"
			},
			"linux":{
				"command": "nohup java -jar ../../Emulicious-with-Java/Emulicious.jar output.sms"
			},
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn":["SMS Batch File Run"]
        },
		{
			"label": "SMS Batch File Run",
			"type": "shell",
			"windows":{
				"command": "..\\..\\..\\assembler\\buildSMS.bat"
			},
			"linux":{
				"command": "bash ../../../assembler/buildSMS.sh"
			},
			"options": {
				"cwd": "${workspaceFolder}/Main"
			},
			"problemMatcher": [],
			"group": {
				"kind": "build",
			}
		}
	]

	
}